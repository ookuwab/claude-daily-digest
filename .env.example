SLACK_WEBHOOK_URL_NEWS=https://hooks.slack.com/services/XXX/YYY/ZZZ
SLACK_WEBHOOK_URL_MAIL=https://hooks.slack.com/services/AAA/BBB/CCC
SLACK_USER_ID=U0123456789

# codex（既定）または claude
AI_PROVIDER=codex

# 未指定時はCodex CLIのデフォルトモデルを使用
# CODEX_MODEL=
CODEX_TIMEOUT=1200
CODEX_RETRY_MAX=3

# AI_PROVIDER=claude の場合のみ使用。sonnet / opus / フルモデルIDを指定可能
# CLAUDE_MODEL=
CLAUDE_TIMEOUT=1200
CLAUDE_RETRY_MAX=3

ENABLE_TECH_FEEDS=true
ENABLE_MAIL_DIGEST=true
